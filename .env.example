# ---- ARRAM spec2 config ----
# Everything here is OPTIONAL. With nothing set, the app still builds and serves
# the existing public website; new modules degrade gracefully (see spec2-design.md §7.2).

# Neon Postgres (enables Payload + all data modules)
DATABASE_URI=
# Non-pooled connection for schema push / migrations (Neon "direct" URL)
DATABASE_URI_DIRECT=
# Any long random string (enables Payload auth/admin). Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# Public site URL (used by Payload for links/emails)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Fast2SMS OTP (enables phone login). Leave blank in dev -> OTP is logged to console.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp

# Cloudflare R2 media storage (enables image uploads)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Behavior
SESSION_DAYS=30
ALLOW_MULTIPLE_PER_NODE=false
