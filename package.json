{
  "name": "arram-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aram Valartha Naayaki Sevai Maiyam (ASM) \u2014 official website. Next.js 16 + Tailwind CSS, SSR, Vercel-ready.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "vercel-build": "if [ -n \"$DATABASE_URI_DIRECT\" ] || [ -n \"$DATABASE_URI\" ]; then payload migrate && (node scripts/seed-geo.mjs || echo \"seed-geo skipped\") && (node scripts/seed-org-geo.mjs || echo \"seed-org-geo skipped\") && (node scripts/seed-bootstrap-admin.mjs || echo \"bootstrap-admin skipped\"); fi && next build"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "payload": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "graphql": "^16.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.5.0",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "sharp": "^0.34.0"
  }
}
